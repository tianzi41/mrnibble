# 知伴（ZhiBan）配置模板
# 用法：复制为 .env 后按需修改。注意本文件不含任何真实密钥。
# 说明：
#   - .env 只放“非密”配置（端口、数据目录、日志级别）。
#   - API Key 请在【设置页】填写，界面填写的密钥会加密存入数据库，绝不写入 .env。
#   - 环境变量仅用于高级用户 / CI 覆盖，禁止在 .env 里写真实密钥。

# 服务监听地址（固定本机回环，绝不绑 0.0.0.0）
ZHIBAN_HOST=127.0.0.1

# 服务端口：默认 8760，被占用则自动顺延（最多到 8770）
ZHIBAN_PORT=8760
ZHIBAN_PORT_MAX=8770

# 运行期数据目录：留空 = 程序目录内 data/（绿色便携）；可填绝对路径覆盖
ZHIBAN_DATA_DIR=

# 日志级别：DEBUG / INFO / WARNING / ERROR
ZHIBAN_LOG_LEVEL=INFO

# 单文件上传大小上限（MB）
ZHIBAN_MAX_UPLOAD_MB=200

# ── 高级：环境变量覆盖（一般无需填写；禁止写真实密钥）────────────────
# ZHIBAN_LLM_BASE_URL=
# ZHIBAN_LLM_MODEL=
# ZHIBAN_LLM_API_KEY=
# ZHIBAN_EMBED_BASE_URL=
# ZHIBAN_EMBED_MODEL=
# ZHIBAN_EMBED_API_KEY=
